{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {"url": "https://raw.githubusercontent.com/InBontWeTrust/DataVis_A2/refs/heads/main/data/agree.csv", "format": {"type": "csv"}},
  "title": {"text": "Agreement with Privacy Statements in Australia", "subtitle": "Percentage of Australians Agreeing with Privacy Statements"},
  "width": "container",
  "height": 300,
  "transform": [{"calculate": "split(datum.Question, 'z')", "as": "question"}],
  
  "encoding": {
    "y": {"field": "Question", "type": "nominal", "axis": {"labelLimit": 150, "labels": false}},
    "x": {"field": "Year", "type": "ordinal", "axis": {"labelAngle": 0}}
  },
  "layer": [
    {
      "mark": "rect",
      "encoding": {
        "color": {
          "field": "Response",
          "type": "quantitative",
          "title": "Percentage Agreeing",
          "legend": null
        }
      }
    },
    {
      "mark": "text",
      "encoding": {
        "text": {"field": "Response", "type": "quantitative"},
        "color": {
          "condition": {"test": "datum['Response'] < 40", "value": "black"},
          "value": "white"
        }
      }
    },
    {
      "mark": {"type": "text", "dx": -75, "align": "right", "fontSize": 10},
      "encoding": {
        "text": 
            {"field": "question", "type": "nominal"},
        "color": {
          "condition": {"test": "datum['Year'] == '2020'", "value": "black"},
          "value": null
        }
      }
    }
  ],
  "config": {
    "axis": {"grid": true, "tickBand": "extent"}

  }
}
