{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 300,
  "title": {"text": "Total GDPR Fines by Country", "subtitle": "Including fines over one million Euros"},
  "projection": {"type": "equalEarth", "scale": 550, "center": [2,47]},
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/FIT3179/Vega-Lite/main/2_symbol_map/js/ne_110m_admin_0_countries.topojson",
        "format": {"type": "topojson", "feature": "ne_110m_admin_0_countries"}
      },
      "mark": {"type": "geoshape", "fill": "lightgray", "stroke": "white"}
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/InBontWeTrust/DataVis_A2/refs/heads/main/data/GDPR_avgfines.csv",
        "format": {"type": "csv"}
      },

      "mark": {"type": "circle"},
      "encoding": {
        "longitude": {"field": "Longitude", "type": "quantitative"},
        "latitude": {"field": "Latitude", "type": "quantitative"},
        
        "size": {
          "field": "TotalFine",
          "type": "quantitative",
          "title": "Total Fine (Euros)",
          "scale": {"type": "sqrt", "zero": false, "range": [10, 1000]},
          "legend": {"title": "Total Fine (Euros)", "values":[2000000, 40000000, 200000000, 4000000000], "orient": "bottom-left", "direction": "horizontal", "fillColor": "white"}
        },
      "tooltip": [
        {"field": "CountryName", "type": "nominal", "title": "Country"},
        {
          "field": "TotalFine",
          "type": "quantitative",
          "title": "Total Fine (Euros)"
        }
      

      ]

      }
    }
  ]
}