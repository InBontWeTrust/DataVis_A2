{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {"text": "Proportion of GDPR Fines by Country", "subtitle": "Only including fines over one million Euros", "fontSize": 18},
  "width": "container",
  "data": {
    "url": "https://raw.githubusercontent.com/InBontWeTrust/DataVis_A2/refs/heads/main/data/GDPR_avgfines_trimmed.csv", "format": {
      "type": "csv"
    }
  },
  
  "encoding": {
    "theta": {"field": "TotalFine", "type": "quantitative", "stack": true},
    "color": {"field": "CountryName", "type": "nominal", "legend": null}
  },
  "layer": [{
    "mark": {"type": "arc", "innerRadius": 50}
  }, {
    "mark": {"type": "text", "radius": 135},
    "encoding": {
      "text": {"field": "TotalFine", "type": "quantitative", "format": ",.0f"}
    }
  },
  {
    "mark": {"type": "text", "radius": 135, "fontWeight": "bold", "dy": -10},
    "encoding": {
      "text": {"field": "CountryName", "type": "nominal"}
    }
  },
  {
    "layer": [{
    "mark": {
      "type": "text",
      "lineBreak": "\n",
      "align": "center",
      "dx": -130,
      "dy": 80,
      "text": "Ireland's GDPR fines \nmake up 60% of \nthe value of fines \nover one million Euros.",
      "fontStyle": "bold"

    },
    "encoding": {
      "color": {"value": "black"}
    }
  }]
  }
      
    

]
}
