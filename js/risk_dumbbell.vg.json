{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {"text": "Perceived Privacy Risks in Australia", "subtitle": "Percentage of Australians concerned about privacy risks", "fontSize": 18},
  "width": "container",
  "data": {"url": "https://raw.githubusercontent.com/InBontWeTrust/DataVis_A2/refs/heads/main/data/privacy_risks_long.csv", "format": {"type": "csv"}},
  "encoding": {
    "x": {
      "field": "Percentage",
      "type": "quantitative",
      "title": "Percentage of Australians Concerned"
    },
    "y": {
      "field": "PrivacyRisk",
      "type": "nominal",
      "title": "Privacy Risk",
      "axis": {
        "offset": 5,
        "ticks": false,
        "minExtent": 70,
        "domain": false
      }
    }
  },
  "layer": [
    {
      "mark": "line",
      "encoding": {
        "detail": {
          "field": "PrivacyRisk",
          "type": "nominal"
        },
        "color": {"value": "#db646f"}
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true
      },
      "encoding": {
        "color": {
          "field": "Year",
          "type": "ordinal",
          "title": "Year"
        },
        "size": {"value": 100},
        "opacity": {"value": 1},
        "tooltip": [
          {"field": "PrivacyRisk", "type": "nominal"},
          {"field": "Percentage", "type": "quantitative"},
          {"field": "Year", "type": "ordinal"}
        ]

      }
    }

  ]
}