{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "data": {"url": "../data/privacy_risks_long.csv", "format": {"type": "csv"}},
  "encoding": {
    "x": {
      "field": "Percentage",
      "type": "quantitative"
    },
    "y": {
      "field": "PrivacyRisk",
      "type": "nominal",
      "title": "Privacy Risk",
      "axis": {
        "offset": 5,
        "ticks": false,
        "minExtent": 70,
        "domain": false
      }
    }
  },
  "layer": [
    {
      "mark": "line",
      "encoding": {
        "detail": {
          "field": "PrivacyRisk",
          "type": "nominal"
        },
        "color": {"value": "#db646f"}
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true
      },
      "encoding": {
        "color": {
          "field": "Year",
          "type": "ordinal",
          "scale": {
            "domain": [2023, 2026],
            "range": ["#e6959c", "#911a24"]
          },
          "title": "Year"
        },
        "size": {"value": 100},
        "opacity": {"value": 1}
      }
    }

  ]
}