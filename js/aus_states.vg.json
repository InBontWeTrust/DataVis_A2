{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "A simple bar chart with ranged data (aka Gantt Chart).",
  "data": {
    "url": "../data/privacy_legislation.csv", "format": {
      "type": "csv"
    }
  },
  "mark": "bar",
  "encoding": {
    "y": {"field": "Legislation", "type": "nominal", "axis": {"labelAngle": 0}},
    "x": {"field": "Start", "type": "quantitative", "scale": {"domain": [1975, 2026]}},
    "x2": {"field": "End"}
  }
}