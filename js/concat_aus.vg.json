{
"$schema": "https://vega.github.io/schema/vega-lite/v5.json",
"params": [
  {
    "name": "start_year",
    "value": 2026,
    "bind": {
      "input": "range",
      "min": 1970,
      "max": 2026,
      "step": 1,
      "name": "Legislation Active In: "
    }
  }],
"vconcat": [
    {
        "width": 550,
  "height": 450,
  "title": {"text": "Privacy Legislation in Australia", "subtitle": "Legislation by Location, State and Federal", "dx": 30},
  "projection": {"type": "mercator", "scale": 650, "center": [105,-11]},
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/FIT3179/Vega-Lite/main/2_symbol_map/js/ne_110m_admin_0_countries.topojson",
        "format": {"type": "topojson", "feature": "ne_110m_admin_0_countries"}
      },
      "mark": {"type": "geoshape", "fill": "lightgray", "stroke": "white"}
    },
    {
      "data": {
       "url": "https://raw.githubusercontent.com/InBontWeTrust/DataVis_A2/refs/heads/main/js/australia_states_simplified.topojson",
        "format": {"type": "topojson", "feature": "AUSADM1gbOpen"}
      },
      "mark": {"type": "geoshape", "fill": null, "stroke": "white"}
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/InBontWeTrust/DataVis_A2/refs/heads/main/data/privacy_legislation.csv",
        "format": {"type": "csv"}
      },

      "mark": {"type": "circle"},
      "transform": [
        {
          "filter": "datum.Start <= start_year && datum.End >= start_year"
        }
      ],
      "encoding": {
        "longitude": {"field": "JitteredLongitude", "type": "quantitative"},
        "latitude": {"field": "JitteredLatitude", "type": "quantitative"},
        "color": {"field": "Location", "type": "nominal", "legend": {"orient": "none",
        "legendX": -60,
        "legendY": 325,
        "padding": 8}},

      "tooltip": [
        {"field": "Legislation", "type": "nominal"},
        {"field": "Location", "type": "nominal"},
        {"field": "Start", "type": "quantitative"},
        {"field": "End", "type": "quantitative"}


      

      ]

      }
    }
  ]


    },


    {
        "data": {
        "url": "https://raw.githubusercontent.com/InBontWeTrust/DataVis_A2/refs/heads/main/data/privacy_legislation.csv", "format": {
        "type": "csv"
        }
        },
        
        "title": {"text": "Timeline of Australian Privacy Legislation", "subtitle": "Use the slider below to view legislation active in a specific year on the map", "dx": -75},
        "width": 750,
        "mark": "bar",
        

        "encoding": {
            "y": {"field": "Legislation", "type": "nominal", "axis": {"labelAngle": 0, "labelFontSize": 7.5}, "sort": "x"},
            "x": {"field": "Start", "type": "quantitative", "scale": {"domain": [1975, 2026]}},
            "x2": {"field": "End", "title": "Years In Force"},
            "color": {"field": "Location", "type": "nominal"},
            "tooltip": [
            {"field": "Legislation", "type": "nominal"},
            {"field": "Location", "type": "nominal"},
            {"field": "Start", "type": "quantitative"},
            {"field": "End", "type": "quantitative"}
            ]
        }
        }
    ]
}
