{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {"text": "Largest GDPR Fines by Sector Over Time",
  "subtitle": "Fines over 1,000,000 Euros, 2019-2026"},
  "width": "container",
  "height": 430,
  "data": {
    "url": "https://raw.githubusercontent.com/InBontWeTrust/DataVis_A2/refs/heads/main/data/GDPR_fines.csv", "format": {
      "type": "csv"
      
    }
  },
  "transform": [
  { "calculate": "toDate(datum.Date)", "as": "date" },
  { "calculate": "log(datum.Fine)", "as": "logFine" }
],
  "mark": "circle",
  "encoding": {
    "x": {
      "field": "date",
      "type": "temporal",
      "scale": {"zero": false},
      "axis": {"title": "Date of Fine"}
    },
    "y": {
      "field": "Fine",
      "type": "quantitative",
      "scale": {"type": "log", "zero": true},
      "axis": {"title": "Fine Amount (Euros)"}
    
    },
    "color": {"field": "Sector", "type": "nominal", "legend": {"fillColor": null, "title": "Sector", "legendX": 10, "legendY": 5, "orient": "none", "values": ["Employment", "Finance, Insurance and Consulting", "Health Care", "Individuals and Private Associations", "Industry and Commerce", "Media, Telecoms and Broadcasting", "Not assigned", "Public Sector and Education", "Real Estate", "Transportation and Energy"]}},
    "tooltip": [
      {"field": "Controller / Processor", "type": "nominal"},
      {"field": "date", "type": "temporal"},
      {"field": "Fine", "type": "quantitative"},
      {"field": "Sector", "type": "nominal"}
    ]

  }
}