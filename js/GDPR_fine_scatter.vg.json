{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {"text": "Largest GDPR Fines by Sector Over Time",
  "subtitle": "Fines over 1,000,000 Euros, 2019-2026"},
  "data": {
    "url": "../data/GDPR_fines.csv", "format": {
      "type": "csv"
    }
  },
  "transform": [
  { "calculate": "toDate(datum.Date)", "as": "date" },
  { "calculate": "log(datum.Fine)", "as": "logFine" }
],
  "mark": "point",
  "encoding": {
    "x": {
      "field": "date",
      "type": "temporal",
      "scale": {"zero": false}
    },
    "y": {
      "field": "Fine",
      "type": "quantitative",
      "scale": {"zero": false}
    },
    "color": {"field": "Sector", "type": "nominal"},
    "tooltip": [
      {"field": "Controller / Processor", "type": "nominal"},
      {"field": "date", "type": "temporal"},
      {"field": "Fine", "type": "quantitative"},
      {"field": "Sector", "type": "nominal"}
    ]

  }
}