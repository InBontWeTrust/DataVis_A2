{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 450,
  "title": {"text": "GDPR Fines by Country and Sector", "subtitle": "Including fines over one million Euros"},
  "projection": {"type": "equalEarth", "scale": 500, "center": [21,47]},
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/FIT3179/Vega-Lite/main/2_symbol_map/js/ne_110m_admin_0_countries.topojson",
        "format": {"type": "topojson", "feature": "ne_110m_admin_0_countries"}
      },
      "mark": {"type": "geoshape", "fill": "lightgray", "stroke": "white"}
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/InBontWeTrust/DataVis_A2/refs/heads/main/data/GDPR_fines.csv",
        "format": {"type": "csv"}
      },

      "mark": {"type": "circle"},
      "encoding": {
        "longitude": {"field": "JitteredLongitude", "type": "quantitative"},
        "latitude": {"field": "JitteredLatitude", "type": "quantitative"},
        "color": {"field": "Sector", "type": "nominal", "legend": {"orient": "bottom-right", "fillColor": "white", "padding": 8, "title": "Sector", "values": ["Employment", "Finance, Insurance and Consulting", "Health Care", "Individuals and Private Associations", "Industry and Commerce", "Media, Telecoms and Broadcasting", "Not assigned", "Public Sector and Education", "Real Estate", "Transportation and Energy"]}},

      "tooltip": [
        {"field": "Country", "type": "nominal"},
        {"field": "Controller / Processor", "type": "nominal"},
      {"field": "Fine", "type": "quantitative"},
      {"field": "Sector", "type": "nominal"}
      

      ]

      }
    },
    {
      "layer": [
        
        {
          "data": {
          "url": "https://raw.githubusercontent.com/InBontWeTrust/DataVis_A2/refs/heads/main/data/privacy_legislation.csv",
          "format": {"type": "csv"}
        },
          "transform": [
            {
              "filter": "datum.Legislation === 'Privacy Act 1988'"
            }
          ],
          "mark": {
            "type": "text",
            "lineBreak": "\n",
            "align": "center",
            "dx": -80,
            "dy": 75,
            "text": "Italy has issued the\nmost GDPR fines \nworth over one million \nEuros, with 35 in total.",
            "fontStyle": "bold"
          }
        }
      ]
    }
  ]
}