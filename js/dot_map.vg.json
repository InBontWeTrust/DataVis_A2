{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 300,
  "title": {"text": "GDPR Fines by Country and Sector", "subtitle": "Including fines over one million Euros"},
  "projection": {"type": "equalEarth", "scale": 500, "center": [21,47]},
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/FIT3179/Vega-Lite/main/2_symbol_map/js/ne_110m_admin_0_countries.topojson",
        "format": {"type": "topojson", "feature": "ne_110m_admin_0_countries"}
      },
      "mark": {"type": "geoshape", "fill": "lightgray", "stroke": "white"}
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/InBontWeTrust/DataVis_A2/refs/heads/main/data/GDPR_fines.csv",
        "format": {"type": "csv"}
      },

      "mark": {"type": "circle"},
      "encoding": {
        "longitude": {"field": "JitteredLongitude", "type": "quantitative"},
        "latitude": {"field": "JitteredLatitude", "type": "quantitative"},
        "color": {"field": "Sector", "type": "nominal", "legend": {"orient": "top-right"}},

      "tooltip": [
        {"field": "Country", "type": "nominal"},
        {"field": "Controller / Processor", "type": "nominal"},
      {"field": "Fine", "type": "quantitative"},
      {"field": "Sector", "type": "nominal"}
      

      ]

      }
    }
  ]
}