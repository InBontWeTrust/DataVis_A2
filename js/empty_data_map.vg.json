{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "GDPR Data Protection Adequacy Ratings per Country",
  "width": 800,
  "height": 500,
  "data": {
    "url": "https://raw.githubusercontent.com/InBontWeTrust/DataVis_A2/refs/heads/main/js/ne_110m_admin_0_countries.topojson",
    "format": {"type": "topojson", "feature": "ne_110m_admin_0_countries"}
  },
  "projection": {"type": "equalEarth"},
  "layer":[
    
    {
      "transform": [
        {
          "lookup": "properties.NAME",
          "from": {
            "data": {
              "url": "https://raw.githubusercontent.com/InBontWeTrust/DataVis_A2/refs/heads/main/data/GDPR_privacy_approval.csv"
            },
            "key": "Country",
            "fields": ["GDPRAdequacy"]
          }
        }
      ],
      "mark": {"type": "geoshape", "stroke": "white"},
      "encoding": {
        "color": {
          "condition": {
            "test": "datum.GDPRAdequacy === null",
            "value": "lightgray"
          },
          "field": "GDPRAdequacy",
          "type": "nominal",
          "scale": {
            "range": ["lightgreen", "seagreen", "darkgreen", "tan"]
          },
          "legend": {
          "title": "GDPR Adequacy",
          "values": ["Adequate", "Special arrangement", "EU or EEA Member", "Inadequate"]
          }
        },
        "tooltip": [
          {"field": "properties.NAME", "type": "nominal", "title": "Country"},
          {"field": "GDPRAdequacy", "type": "nominal", "title": "GDPR Adequacy"}
        ]
      }
    }
  ]
  
}