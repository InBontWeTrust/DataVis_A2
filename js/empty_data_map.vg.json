{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {"text": "Data Protection Adequacy Ratings by Country", "subtitle": "European Commission decisions that deem protections essentially equivalent to GDPR"},
  "width": "container",
  "height": 400,
  "data": {
    "url": "https://raw.githubusercontent.com/InBontWeTrust/DataVis_A2/refs/heads/main/js/ne_110m_admin_0_countries.topojson",
    "format": {"type": "topojson", "feature": "ne_110m_admin_0_countries"}
  },
  "projection": {"type": "equalEarth"},
  "layer":[
    
    {
      "transform": [
        {
          "lookup": "properties.NAME",
          "from": {
            "data": {
              "url": "https://raw.githubusercontent.com/InBontWeTrust/DataVis_A2/refs/heads/main/data/GDPR_privacy_approval.csv"
            },
            "key": "Country",
            "fields": ["GDPRAdequacy"]
          }
        }
      ],
      "mark": {"type": "geoshape", "stroke": "white"},
      "encoding": {
        "color": {
          "condition": {
            "test": "datum.GDPRAdequacy === null",
            "value": "lightgray"
          },
          "field": "GDPRAdequacy",
          "type": "nominal",
          "scale": {
            "range": ["limegreen", "darkgreen", "darkblue", "lightgray"]
          },
          "legend": {
          "title": "GDPR Adequacy",
          "values": ["EU or EEA Member", "Adequate", "Special arrangement", "Inadequate"],
          "orient": "bottom-left"
          }
        },
        "tooltip": [
          {"field": "properties.NAME", "type": "nominal", "title": "Country"},
          {"field": "GDPRAdequacy", "type": "nominal", "title": "GDPR Adequacy"}
        ]
      }
    },

    {
      "layer": [
        
        {
          "data": {
          "url": "https://raw.githubusercontent.com/InBontWeTrust/DataVis_A2/refs/heads/main/data/privacy_legislation.csv",
          "format": {"type": "csv"}
        },
          "transform": [
            {
              "filter": "datum.Legislation === 'Privacy Act 1988'"
            }
          ],
          "mark": {
            "type": "text",
            "lineBreak": "\n",
            "align": "center",
            "dx": -240,
            "dy": -115,
            "text": "Canada and the \nUSA have special \nagreements \nfor commercial \norganisations.",
            "fontStyle": "bold"
          }
        }
      ]
    }
  ]
  
}